# Neon Postgres connection string (Neon dashboard -> Connection Details)
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clerk keys (Clerk dashboard -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx

# Clerk routing: use the site's own branded pages
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/ideas
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/welcome

# Optional: comma-separated emails that are always treated as admins
# (bootstrap only; the preferred mechanism is Clerk publicMetadata.role = "admin")
ADMIN_EMAILS=

# Clerk webhook (Clerk dashboard → Webhooks → endpoint https://panagreen.org/api/webhooks/clerk;
# events user.created, user.updated, user.deleted). Copy the endpoint signing secret here.
CLERK_WEBHOOK_SIGNING_SECRET=
# Optional: DATABASE_URL_UNPOOLED is preferred by db/migrate.mjs when present.
